{:paths ["src" "resources"]
 :deps  {org.clojure/clojure                 {:mvn/version "1.12.5"}
         datalevin/datalevin                 {:mvn/version "1.0.1"}
         com.github.crinklywrappr/syncopate  {:mvn/version "1.0.9"}
         integrant/integrant                 {:mvn/version "1.0.1"}
         http-kit/http-kit                   {:mvn/version "2.8.0"}
         metosin/reitit                      {:mvn/version "0.7.2"}
         metosin/malli                       {:mvn/version "0.16.4"}
         metosin/jsonista                    {:mvn/version "0.3.8"}
         com.taoensso/telemere               {:mvn/version "1.0.1"}}
 :aliases
 {:run {:main-opts ["-m" "engram.main"]
        :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check               {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                     "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
