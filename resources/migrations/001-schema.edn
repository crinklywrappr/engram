;; Database creation — the full initial schema for engram.
;;
;; A memory is one atomic fact owned by a user. Its category:label pairs are
;; stored as component tag entities so datalog can match a pair and stats can
;; group by it. `related` holds the src values this fact links to; the recall
;; walks that graph transitively. `content` is full-text indexed so a future
;; search feature can use it (not on the recall path).
;;
;; A stat row counts, per (user, category, label), how often a pair was recalled:
;; a monotonic lifetime count and an exponential-decay recent count. The
;; composite tuple :stat/user+category+label is a unique identity, so a recall
;; upserts the row. There is no delimiter, so no user id can collide two rows.
;;
;; syncopate additive creation migration: :down is auto-derived.
{:up {:schema/create {:memory/id          {:db/valueType :db.type/uuid    :db/unique :db.unique/identity}
               :memory/user        {:db/valueType :db.type/string}
               :memory/content     {:db/valueType :db.type/string  :db/fulltext true}
               :memory/src         {:db/valueType :db.type/string}
               :memory/tag         {:db/valueType :db.type/ref     :db/cardinality :db.cardinality/many :db/isComponent true}
               :memory/related     {:db/valueType :db.type/string  :db/cardinality :db.cardinality/many}
               :memory/created-at  {:db/valueType :db.type/instant}
               :memory/updated-at  {:db/valueType :db.type/instant}
               :tag/category       {:db/valueType :db.type/string}
               :tag/label          {:db/valueType :db.type/string}
               :stat/user          {:db/valueType :db.type/string}
               :stat/category      {:db/valueType :db.type/string}
               :stat/label         {:db/valueType :db.type/string}
               :stat/user+category+label {:db/tupleAttrs [:stat/user :stat/category :stat/label]
                                          :db/unique :db.unique/identity}
               :stat/lifetime      {:db/valueType :db.type/long}
               :stat/decayed       {:db/valueType :db.type/double}
               :stat/last-request  {:db/valueType :db.type/instant}}}}
